# Redirige toutes les routes vers index.html, sauf les fichiers et dossiers
# qui existent réellement (JS, CSS, images...). Nécessaire pour que les
# vraies URLs (/portfolio, /about, /contact) fonctionnent aussi en rechargeant
# la page ou en y accédant directement, pas seulement via la navigation
# interne du site.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
